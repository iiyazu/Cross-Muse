# pipeline, group B (mention wakes, no alignment): opencode implements, dsh reviews (no Claude)
SEED=pipeline
GROUP=B
IMPL=opencode-1
REVIEW=dsh-1
AGENTS="opencode-1:opencode dsh-1:dsh"
ROT=1
ROT_AT=review_reply
ROT_MATCH="tie|same level|alphabet|ascending|name|名字|升序|层内|level|order"
MAX_CHAIN_WAKES=20
TIMEOUT=3600
