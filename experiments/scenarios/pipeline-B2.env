# T6 E1 comparison arm / E2a control: opencode implements, dsh reviews, mention wakes, alignment off; SPEC v2 overlay (needs dsh: run on r7)
SEED=pipeline
GROUP=B
OVERLAY=spec-v2
IMPL=opencode-1
REVIEW=dsh-1
AGENTS="opencode-1:opencode dsh-1:dsh"
ROT=1
ROT_AT=review_reply
ROT_MATCH="tie|same level|alphabet|ascending|name|名字|升序|层内|level|order"
MAX_CHAIN_WAKES=20
TIMEOUT=3600
