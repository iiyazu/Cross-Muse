# group L (long session): the same hub state and sessions do ledger, then minisql, then pipeline
SEEDS="ledger minisql pipeline"
GROUP=L
IMPL=opencode-1
REVIEW=dsh-1
AGENTS="opencode-1:opencode dsh-1:dsh"
ROT=1
ROT_AT=review_request
ROT_MATCH="cent|integer|NULL|alphabet|name"
MAX_CHAIN_WAKES=20
TIMEOUT=5400
