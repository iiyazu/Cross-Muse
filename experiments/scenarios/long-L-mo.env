# group L with MemoryOS on (ops variant): same tasks as long-L, measures /recall and curate ops.
# Unattended: curate proposals are never confirmed; task help is evaluated by T1 offline replay.
SEEDS="ledger minisql pipeline"
GROUP=L
IMPL=opencode-1
REVIEW=dsh-1
AGENTS="opencode-1:opencode dsh-1:dsh"
ROT=1
ROT_AT=review_reply
ROT_MATCH="cent|integer|NULL|alphabet|name"
MAX_CHAIN_WAKES=20
TIMEOUT=5400
MEMORYOS=on
