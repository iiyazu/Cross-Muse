# T6 E2a treatment: as B2 plus the alignment layer; SPEC v2 overlay (needs dsh: run on r7)
SEED=minisql
GROUP=C
OVERLAY=spec-v2
IMPL=opencode-1
REVIEW=dsh-1
AGENTS="opencode-1:opencode dsh-1:dsh"
ROT=1
ROT_AT=review_reply
ROT_MATCH="NULL|null|空值|ORDER BY|sort|排序|first|last"
MAX_CHAIN_WAKES=20
TIMEOUT=3600
