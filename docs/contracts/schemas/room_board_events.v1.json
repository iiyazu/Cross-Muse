{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xmuse.local/contracts/schemas/room_board_events.v1.json",
  "title": "room_board_events/v1",
  "type": "object",
  "properties": {
    "schema_version": { "const": "room_board_events/v1" },
    "conversation_id": { "type": "string" },
    "board_seq": { "type": "integer", "minimum": 0 },
    "revision": { "type": "string" },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "has_more": { "type": "boolean" },
    "reset": { "type": "boolean" }
  },
  "required": [
    "schema_version",
    "conversation_id",
    "board_seq",
    "revision",
    "events",
    "has_more",
    "reset"
  ],
  "additionalProperties": false,
  "$defs": {
    "agentText": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "untrusted": { "const": true },
        "truncated": { "type": "boolean" }
      },
      "required": ["text", "untrusted", "truncated"],
      "additionalProperties": false
    },
    "nullableAgentText": {
      "anyOf": [{ "$ref": "#/$defs/agentText" }, { "type": "null" }]
    },
    "findingsCount": {
      "type": "object",
      "properties": {
        "blocker": { "type": "integer", "minimum": 0 },
        "major": { "type": "integer", "minimum": 0 },
        "minor": { "type": "integer", "minimum": 0 }
      },
      "required": ["blocker", "major", "minor"],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "severity": { "enum": ["blocker", "major", "minor"] },
        "path": {"anyOf": [{"type": "string", "pattern": "^(?![/])(?![A-Za-z]:)(?!(?:.*/)?\\.{1,2}(?:/|$))[^\\\\\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u0600-\\u0605\\u061c\\u06dd\\u070f\\u0890-\\u0891\\u08e2\\u180e\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u206f\\ufeff\\ufff9-\\ufffb]{1,512}$"}, {"type": "null"}]},
        "text": { "$ref": "#/$defs/agentText" }
      },
      "required": ["severity", "path", "text"],
      "additionalProperties": false
    },
    "escalation": {
      "type": "object",
      "properties": {
        "participant_id": { "type": "string" },
        "family": { "type": "string" },
        "reason_code": {
          "enum": [
            "board_review_reviewer_unavailable",
            "board_review_reviewer_no_verdict",
            "board_review_reviewer_unresponsive"
          ]
        },
        "at": { "type": "string" }
      },
      "required": ["participant_id", "family", "reason_code", "at"],
      "additionalProperties": false
    },
    "nullableEscalation": {
      "anyOf": [{ "$ref": "#/$defs/escalation" }, { "type": "null" }]
    },
    "event": {
      "type": "object",
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "kind": {
          "enum": [
            "split_proposed",
            "split_rejected",
            "charter_assigned",
            "claimed",
            "contract_published",
            "contract_revised",
            "progress",
            "question",
            "verification",
            "review_requested",
            "review"
          ]
        },
        "at": { "type": "string" },
        "module_id": { "type": ["string", "null"] },
        "actor": {
          "type": "object",
          "properties": {
            "kind": { "enum": ["participant", "operator", "infrastructure"] },
            "participant_id": { "type": ["string", "null"] }
          },
          "required": ["kind", "participant_id"],
          "additionalProperties": false
        },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "split_id": { "type": "string" },
                "module_ids": { "type": "array", "items": { "type": "string" } }
              },
              "required": ["split_id", "module_ids"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "split_id": { "type": "string" },
                "decided_via": { "type": ["string", "null"] }
              },
              "required": ["split_id", "decided_via"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "split_id": { "type": "string" },
                "owner_participant_id": { "type": "string" },
                "charter_version": { "type": "integer" },
                "decided_via": { "type": ["string", "null"] }
              },
              "required": ["split_id", "owner_participant_id", "charter_version", "decided_via"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "contract_id": { "type": "string" },
                "version": { "type": "integer" },
                "kind": { "enum": ["api_schema", "types", "protocol", "text"] },
                "digest": { "type": "string" },
                "rationale": { "$ref": "#/$defs/nullableAgentText" }
              },
              "required": ["contract_id", "version", "kind", "digest", "rationale"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": { "enum": ["working", "blocked", "ready_for_review", "done"] },
                "summary": { "$ref": "#/$defs/agentText" },
                "claims": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/agentText" },
                  "maxItems": 8
                },
                "claims_total": { "type": "integer", "minimum": 0 }
              },
              "required": ["status", "summary", "claims", "claims_total"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "target_participant_id": { "type": "string" },
                "question": { "$ref": "#/$defs/agentText" }
              },
              "required": ["target_participant_id", "question"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "verification_id": { "type": "string" },
                "status": { "enum": ["passed", "failed", "error"] },
                "reason_code": { "type": ["string", "null"] },
                "gate_ids": { "type": "array", "items": { "type": "string" } },
                "escalated": { "type": "boolean" },
                "stacked": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "module_id": { "type": "string" },
                      "verification_id": { "type": "string" }
                    },
                    "required": ["module_id", "verification_id"],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "verification_id",
                "status",
                "reason_code",
                "gate_ids",
                "escalated",
                "stacked"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "review_id": { "type": "string" },
                "verification_id": { "type": "string" },
                "rule_id": { "type": "string" },
                "author_family": { "type": "string" },
                "reviewer_kind": { "enum": ["participant", "operator"] },
                "reviewer_participant_id": { "type": ["string", "null"] },
                "reviewer_family": { "type": ["string", "null"] },
                "escalated_from": { "$ref": "#/$defs/nullableEscalation" }
              },
              "required": [
                "review_id",
                "verification_id",
                "rule_id",
                "author_family",
                "reviewer_kind",
                "reviewer_participant_id",
                "reviewer_family",
                "escalated_from"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "review_id": { "type": "string" },
                "verdict": { "enum": ["endorse", "object"] },
                "findings_count": { "$ref": "#/$defs/findingsCount" },
                "findings": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/finding" },
                  "maxItems": 8
                },
                "findings_total": { "type": "integer", "minimum": 0 },
                "summary": { "$ref": "#/$defs/agentText" },
                "decided_via": { "enum": ["board_tool", "web"] }
              },
              "required": [
                "review_id",
                "verdict",
                "findings_count",
                "findings",
                "findings_total",
                "summary",
                "decided_via"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["seq", "kind", "at", "module_id", "actor", "data"],
      "additionalProperties": false
    }
  }
}
