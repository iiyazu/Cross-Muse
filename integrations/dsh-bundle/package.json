{
  "name": "xmuse-dsh-bundle",
  "version": "0.1.0",
  "description": "xmuse 2 dsh relay: /xmuse bind|unbind|status, 7 native xmuse_* tools, long-poll relay of hub messages into the bound session",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node --import ./test/register.mjs --test test/bundle.test.mjs"
  },
  "files": [
    "index.js",
    "tools.json",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-commands": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
