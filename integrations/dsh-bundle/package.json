  "files": [
    "index.js",
    "client.js",
    "sidebar-host.js",
    "tools.json",
    "cordis.patch.yml",
    "SIDEBAR.zh.md",
    "locale/*.json"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-commands": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
